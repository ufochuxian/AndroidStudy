<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 未选中 Tab 样式 -->
    <style name="TabTextNormal" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- 选中 Tab 样式 -->
    <style name="TabTextSelected" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TabSelectedTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">22sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
